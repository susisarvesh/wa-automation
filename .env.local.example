# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (webhook, automation engine, Google workspace attach).
# Keep this secret — never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# AUTH — Google via Supabase (free / open-source stack)
# ============================================================

# google (default, production) | none (open demo, no login)
AUTH_PROVIDER=google
# Must match AUTH_PROVIDER so the browser knows which mode to use
NEXT_PUBLIC_AUTH_PROVIDER=google

# Optional: comma-separated allowlist. Empty = any Google user can join.
# AUTH_ALLOWED_EMAILS=you@vsmarttec.com,ops@vsmarttec.com

# Canonical public URL (scheme + host, no trailing slash). Used for
# OAuth redirects when request origin is wrong (cron / workers).
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# In Supabase Dashboard:
#   Authentication → Providers → Google → enable
#   Authentication → URL Configuration → Redirect URLs:
#     http://localhost:3000/auth/callback
#     https://your-domain.com/auth/callback
# Google Cloud Console OAuth client: add the Supabase callback URL shown
# in the provider settings (…/auth/v1/callback).

# ============================================================
# SINGLE-TENANT WORKSPACE — one fixed account for the deploy
# ============================================================
SINGLE_TENANT_MODE=true
SINGLE_TENANT_ACCOUNT_ID=a0000000-0000-4000-8000-000000000001
NEXT_PUBLIC_SINGLE_TENANT_ACCOUNT_ID=a0000000-0000-4000-8000-000000000001

# Only used when AUTH_PROVIDER=none (open demo)
# SINGLE_TENANT_PASSWORD=mvp-dev-only-change-me

# Skip Meta verification when saving WhatsApp connect (local demo only)
# WHATSAPP_CONNECT_SKIP_VERIFY=true

# ============================================================
# RECOMMENDED
# ============================================================

NEXT_PUBLIC_APP_LOCALE=en

# Shared secret protecting GET /api/automations/cron (Wait steps).
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID — needed for IMAGE header templates.
# META_APP_ID=your-meta-app-id

# WHATSAPP_TEMPLATES_DRY_RUN=true
